# Local testing only (e.g. with the MCP Inspector).
# In Claude Desktop, set these in the `env` block of claude_desktop_config.json instead.
# Copy this file to `.env`, fill in real values, and keep `.env` OUT of git.

SF_USERNAME=integrations@replicon.com
SF_PASSWORD=your-password-here
SF_SECURITY_TOKEN=your-security-token-here

# "login" for production, "test" for a sandbox, or a My Domain host
# like "acme.my.salesforce.com"
SF_DOMAIN=login
